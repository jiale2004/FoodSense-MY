# LLM Provider: "openai" or "gemini"
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Roboflow (optional; required only for downloading external datasets)
ROBOFLOW_API_KEY=

# Google Gemini
GEMINI_API_KEY=
# gemini-2.0-flash was shut down 1 Jun 2026; use 2.5 Flash-Lite (cheap) or 2.5 Flash
GEMINI_MODEL=gemini-2.5-flash-lite

# Model & Data Paths (relative to project root)
MODEL_WEIGHTS_PATH=data/weights/best.pt
KNOWLEDGE_BASE_PATH=data/knowledge_base.json

# Detection Settings (NMS)
CONFIDENCE_THRESHOLD=0.47
IOU_THRESHOLD=0.45
DEVICE=auto

# Upload Settings
MAX_UPLOAD_SIZE_MB=10

# Optional API Key Protection (disabled by default)
API_KEY_ENABLED=false
API_KEY=
